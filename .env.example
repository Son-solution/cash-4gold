# Copy to .env.local and adjust. All variables are optional.

# Public site URL – used for canonical URLs, OpenGraph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://cash-4gold.de

# ── Purchase prices from gold-sohn.de (preferred source) ──────────────────────────
# /api/cron/prices scrapes https://gold-sohn.de/preise/ and stores the result in Upstash Redis.
# Connecting "Upstash for Redis" in Vercel → Storage sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# A database created directly on upstash.com can use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Key prefix in Redis (default: cash4gold). Use a different prefix per site if the database is shared.
PRICES_KEY_PREFIX=cash4gold

# Protects /api/cron/prices: callers must send "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it automatically. Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Fallback: market prices from https://metals.dev (used only if Redis is not configured) ──
# Server-side only – never exposed to the browser. Without Redis and without a key the site shows demo prices.
METALS_DEV_API_KEY=

# How often the server fetches a new price from metals.dev, in seconds (default: 1800 = 30 minutes).
# Requests per month ≈ 2,592,000 / value + ~30 for history (+ ~28 once). Free plan: 100/month → use 86400 (24 h).
# Copper plan (2,000/month): 1800. Silver plan (10,000/month): 300.
METALS_DEV_CACHE_SECONDS=1800

# Client-side price refresh interval in milliseconds (default: 300000 = 5 minutes).
# gold-sohn.de: set it to the interval of your cron / scheduler. metals.dev: METALS_DEV_CACHE_SECONDS × 1000.
NEXT_PUBLIC_PRICE_REFRESH_MS=300000

# Optional external endpoint for the contact form (e.g. a form provider or CRM webhook).
# If empty, the form posts to the built-in route /api/contact.
NEXT_PUBLIC_CONTACT_ENDPOINT=
